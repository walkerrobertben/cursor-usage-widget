# Copy to one of:
#   ~/Library/Application Support/CursorUsage/.env   (recommended for the .app)
#   .env next to CursorUsage.app
#   .env in this project directory (swift run)
#
# Default (no config needed):
#   ~/Library/Application Support/Cursor
#
# Custom profile (Cursor launched with --user-data-dir):
#   CURSOR_USER_DATA_DIR=/path/to/your/cursor-data
#
# Or point directly at the SQLite DB:
#   CURSOR_STATE_DB=/path/to/User/globalStorage/state.vscdb
#
# Tip: ask your agent to find your Cursor user-data-dir from running processes:
#   ps -ax -o args= | grep -i 'Cursor.*--user-data-dir'

CURSOR_USER_DATA_DIR=
